# Copie este arquivo para .env ou execute python3 init.py para cria-lo automaticamente.
# O arquivo .env e privado e nao deve ser enviado ao GitHub.
BILBO_BIND_ADDRESS=127.0.0.1
BILBO_HOST_PORT=8890
BILBO_FASTQC_TIMEOUT=170m
# Preencha apenas se o navegador usa um dominio ou endereco diferente de localhost.
BILBO_PUBLIC_BASE_URL=

# Portas no computador hospedeiro. As portas internas do Docker nao mudam.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
OLLAMA_HOST_PORT=11435
SSH_HOST_PORT=2222
PGADMIN_HOST_PORT=8080

POSTGRES_USER=bilbo
POSTGRES_DB=bioinfo
POSTGRES_PASSWORD=
SECRET_KEY=
SSH_USER_NAME=bilbo
SSH_USER_PASSWORD=
PGADMIN_DEFAULT_EMAIL=admin@localhost.localdomain
PGADMIN_DEFAULT_PASSWORD=

CLUSTER_INTERPRETATION_MODEL=gemma3:4b
RAG_LLM_MODEL=gemma3:4b
RAG_EMBEDDING_MODEL=bge-m3:latest

# Configurados uma vez pelos mantenedores do BILBO. Usuarios apenas autorizam
# suas contas Google no modal de importacao, a cada abertura.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=
# Opcional: se vazio, usa BILBO_PUBLIC_BASE_URL ou localhost:BILBO_HOST_PORT.
GOOGLE_DRIVE_REDIRECT_URI=
# Opcional: se vazio, aceita localhost e 127.0.0.1 na porta BILBO_HOST_PORT.
CORS_ORIGINS=
