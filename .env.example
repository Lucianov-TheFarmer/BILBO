APP_ENV=development
SECRET_KEY=dev-secret-key-123

# deixe vazio para usar POSTGRES_* automaticamente
DATABASE_URL=

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bioinfo

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

OLLAMA_HOST=http://ollama:11434
OLLAMA_HOST_PORT=11435

LLM_PRIMARY_MODEL=qwen3:14b
LLM_FALLBACK_MODELS=qwen3:8b,qwen3:0.6b

USERS_ROOT=/users
LOG_LEVEL=INFO
DB_STARTUP_MAX_ATTEMPTS=30
DB_STARTUP_RETRY_SECONDS=2
ARTIFACT_RETENTION_DAYS=30
LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90

SSH_USER_NAME=bilbo
SSH_USER_PASSWORD=bilbo123
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
